[Unit]
Description=adan.ltd Blog System (Spring Boot, port 8080)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/java -Xms64m -Xmx256m -XX:+UseSerialGC -jar /opt/adan-blog/backend/target/adan-blog-1.0.0.jar
Restart=always
RestartSec=5
WorkingDirectory=/opt/adan-blog
# 数据目录
Environment=adan.blog.upload-dir=/var/lib/adan-blog/uploads
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
